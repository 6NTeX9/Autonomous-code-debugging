# Autonomous Code Debugging Agent Environment Configuration

# LLM Configuration
# Set to 'mock' for standalone local demonstration without external keys
# Set to 'openai' to use OpenAI or an OpenAI-compatible endpoint
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# Orchestrator & Safety
MAX_ITERATIONS=5
EXECUTION_TIMEOUT_SECONDS=60

# Sandbox Environment: 'auto', 'docker', or 'process'
SANDBOX_TYPE=auto

# Server & Database
DATABASE_URL=sqlite:///./debugging_agent.db
PORT=8000
